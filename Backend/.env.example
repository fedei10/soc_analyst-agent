# Single MAPE-K reasoning provider.
LLM_PROVIDER=oxy
LLM_API_KEY=
LLM_BASE_URL=https://api.oxyy.ai/v1
LLM_MODEL=gpt-oss-120b
WAZUH_INGESTION_INTERVAL_SECONDS=20
WAZUH_INGESTION_PAGE_SIZE=500
WAZUH_INGESTION_MAX_PAGES_PER_RUN=20
WAZUH_INGESTION_ORGANIZATION_ID=system
LLM_TIMEOUT_SECONDS=30
MAPEK_ANALYSIS_CONFIDENCE_THRESHOLD=0.75
MAPEK_MAX_ANALYSIS_ATTEMPTS=2
MAPEK_MAX_PLANNING_RETRIES=1
MAPEK_MAX_INPUT_TOKENS=8000
MAPEK_MAX_TOOL_CALLS_PER_STAGE=4
MAPEK_CORRELATION_WINDOW_SECONDS=600
MAPEK_DRY_RUN=true
MAPEK_REAL_EXECUTION_ENABLED=false
MAPEK_TEMPORARY_BLOCK_TTL_SECONDS=900
MAPEK_PROTECTED_IPS=
MAPEK_APPROVED_ADMIN_IPS=
MAPEK_PROTECTED_ACCOUNTS=root,wazuh
MAPEK_PROTECTED_PROCESSES=sshd,wazuh-agentd
MAPEK_PROTECTED_PORTS=22,55000,9200
MAPEK_MAINTENANCE_WINDOW_ACTIVE=false

# Structured operational logging and optional OpenTelemetry export.
ENVIRONMENT=development
SERVICE_NAME=tsage-soc-api
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_CALLSITE=false
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_TOOL_PAYLOADS=false
LOG_MODEL_CONTENT=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=1.0
SLOW_REQUEST_THRESHOLD_MS=1000
SLOW_TOOL_THRESHOLD_MS=2000
SLOW_MODEL_THRESHOLD_MS=10000

# Wazuh Indexer (OpenSearch, through SSH tunnel -> localhost)
WAZUH_INDEXER_HOST=127.0.0.1
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_ARCHIVE_INDEX=wazuh-archives-*

# Wazuh Server API (through SSH tunnel -> localhost)
WAZUH_BASE_URL=https://localhost:55000
WAZUH_USERNAME=wazuh
WAZUH_PASSWORD=
WAZUH_RESPONDER_USERNAME=
WAZUH_RESPONDER_PASSWORD=
# verify_ssl=false is allowed for LOCAL LAB ONLY
WAZUH_VERIFY_SSL=false
WAZUH_CA_CERT=
WAZUH_TIMEOUT=15
WAZUH_DEFAULT_LIMIT=100
WAZUH_MAX_LIMIT=500
# Safety rails: reads only by default; dangerous tools stay off unless explicitly enabled
WAZUH_READ_ONLY=true
WAZUH_ALLOW_DANGEROUS_TOOLS=false

# Deterministic alert normalization and bounded agent context.
WAZUH_AGENT_RESPONSE_MODE=compact
WAZUH_NORMALIZATION_ENABLED=true
WAZUH_RAW_EVIDENCE_ENABLED=true
ALERT_AGGREGATION_WINDOW_SECONDS=300
AUTH_AGGREGATION_WINDOW_SECONDS=600
VULNERABILITY_AGGREGATION_WINDOW_SECONDS=86400
COMPLIANCE_AGGREGATION_WINDOW_SECONDS=86400
MAX_FINDINGS_PER_AGENT_RESPONSE=10
MAX_EVIDENCE_REFS_PER_FINDING=20
MAX_NORMALIZED_ALERTS_PER_RESPONSE=50

# PostgreSQL persistence. Use postgresql:// so SQLAlchemy and LangGraph's
# PostgresSaver can share the same connection string.
DATABASE_URL=
DATABASE_AUTO_CREATE=false
DATABASE_REQUIRED=false
TSAGE_POSTGRES_DB=tsage
TSAGE_POSTGRES_USER=tsage
TSAGE_POSTGRES_PASSWORD=change-me
TSAGE_POSTGRES_PORT=5434

# Ephemeral Redis coordination and activity streaming.
REDIS_URL=redis://:change-me@127.0.0.1:6380/0
REDIS_REQUIRED=false
TSAGE_REDIS_PASSWORD=change-me
TSAGE_REDIS_PORT=6380

# Durable retention defaults.
RETENTION_MESSAGES_DAYS=90
RETENTION_TOOL_PAYLOAD_DAYS=30
RETENTION_CHECKPOINT_DAYS=30
RETENTION_INVESTIGATION_DAYS=365

# API-host diagnostics and human-approved remediation.
SYSTEM_DIAGNOSTICS_ENABLED=false
SELF_HEALING_ENABLED=false
SELF_HEALING_SERVICE_ALLOWLIST=
SYSTEM_COMMAND_TIMEOUT=10

# Clerk session-token verification for FastAPI. Keyless mode can bootstrap the
# Next.js app; after claiming it, copy the server key here. CLERK_JWT_KEY is
# optional but enables networkless RS256 verification.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001
CLERK_EXECUTOR_USER_IDS=
CLERK_SOC_L2_USER_IDS=
CLERK_SOC_L3_USER_IDS=
CLERK_SECURITY_ADMIN_USER_IDS=
CLERK_AUDITOR_USER_IDS=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tsage
LANGSMITH_ENDPOINT=
# Keep SOC prompts, evidence, and tool output out of remote traces by default.
# For a local lab where you explicitly want to inspect full assistant inputs and
# outputs in LangSmith, set both hide flags to false. Raw Wazuh fields and
# full_log content remain compacted unless their include flags are also enabled.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_INCLUDE_RAW_ALERTS=false
LANGSMITH_INCLUDE_FULL_LOG=false
REVISION_ID=development
