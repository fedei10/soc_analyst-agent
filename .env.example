OXYY_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Wazuh Indexer (OpenSearch, through SSH tunnel -> localhost)
WAZUH_INDEXER_HOST=127.0.0.1
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=

# Wazuh Server API (through SSH tunnel -> localhost)
WAZUH_BASE_URL=https://localhost:55000
WAZUH_USERNAME=wazuh
WAZUH_PASSWORD=
WAZUH_RESPONDER_USERNAME=
WAZUH_RESPONDER_PASSWORD=
# verify_ssl=false is allowed for LOCAL LAB ONLY
WAZUH_VERIFY_SSL=false
WAZUH_CA_CERT=
WAZUH_TIMEOUT=15
WAZUH_DEFAULT_LIMIT=100
WAZUH_MAX_LIMIT=500
# Safety rails: reads only by default; dangerous tools stay off unless explicitly enabled
WAZUH_READ_ONLY=true
WAZUH_ALLOW_DANGEROUS_TOOLS=false

# Bearer tokens for THIS API (comma-separated). Read = agents, write = human-held.
SOC_READ_API_KEYS=
SOC_WRITE_API_KEYS=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tsage
LANGSMITH_ENDPOINT=
